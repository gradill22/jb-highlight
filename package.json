{
  "name": "myst-annotate",
  "version": "0.1.0",
  "description": "Local, private highlighting and annotation (Markdown + math) for Jupyter Book 2 / MyST sites.",
  "type": "module",
  "main": "./dist/myst-annotate.mjs",
  "exports": {
    ".": "./dist/myst-annotate.mjs",
    "./widget.js": "./dist/widget.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "jupyter-book",
    "mystmd",
    "myst-plugin",
    "annotation",
    "highlight",
    "hypothesis",
    "anywidget"
  ],
  "author": "Grady Dillon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradill22/jb-highlight.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jupyter-book": "2.1.7",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "playwright": "1.63.0"
  }
}
